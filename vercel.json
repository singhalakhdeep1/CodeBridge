{
  "buildCommand": "pnpm build",
  "outputDirectory": ".next",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "env": {
    "NEXT_PUBLIC_GRAPHQL_HTTP_URL": {
      "description": "GraphQL HTTP endpoint URL",
      "value": "https://codebridge.vercel.app/api/graphql"
    },
    "NEXT_PUBLIC_GRAPHQL_WS_URL": {
      "description": "GraphQL WebSocket endpoint URL",
      "value": "wss://codebridge.vercel.app/api/graphql"
    },
    "NEXT_PUBLIC_SUPABASE_URL": {
      "description": "Supabase project URL"
    },
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": {
      "description": "Supabase anonymous key"
    },
    "UPSTASH_REDIS_REST_URL": {
      "description": "Upstash Redis REST URL"
    },
    "UPSTASH_REDIS_REST_TOKEN": {
      "description": "Upstash Redis REST token"
    },
    "SENTRY_DSN": {
      "description": "Sentry DSN for error tracking"
    },
    "POSTHOG_KEY": {
      "description": "PostHog API key"
    },
    "OPENAI_API_KEY": {
      "description": "OpenAI API key for AI features"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/api/graphql",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/graphql",
      "destination": "/api/graphql/route"
    }
  ],
  "functions": {
    "app/api/graphql/**": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cleanup",
      "schedule": "0 0 * * *"
    }
  ]
}
